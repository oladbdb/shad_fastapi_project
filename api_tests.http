# Набор тестов для эндпоинтов которые можно запустить
# в VSCode с помощью плагина  REST Client
# Найти можно по идентификатору: humao.rest-client
# Tunder Client не позволяет свободно импортировать-экспортировать записи,
# поэтому перешел на этот плагин. Он тоже хорош :-)

@token = PASTE_JWT_TOKEN_HERE

# Создаем книгу
POST http://localhost:8008/api/v1/books/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "title": "Clean Architecture",
    "author": " Robert Martin",
    "count_pages": 300,
    "year": 2025
}

###

# Получаем список книг
GET http://localhost:8008/api/v1/books/ HTTP/1.1

###

# Получаем одну книгу по ее ИД
GET http://localhost:8008/api/v1/books/1 HTTP/1.1

###

# Удаляем книгу
DELETE http://localhost:8008/api/v1/books/1 HTTP/1.1

###

# Обновляем поля в данных о книге
PUT http://localhost:8008/api/v1/books/1 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "id": 1,
    "title": "Clean Code",
    "author": "Robert Martin",
    "year": 2022,
    "pages": 310
}

###


# Обновляем поля в данных о книге
PATCH http://localhost:8008/api/v1/books/1 HTTP/1.1
Content-Type: application/json

{
    "title": "Mziri",
    "pages": 310
}

###



#Получаем токен
POST http://localhost:8008/api/v1/token HTTP/1.1
Content-Type: application/json

{
  "e_mail": "testsellerr@example.com",
  "password": "pass"
}


###


#Создаем продавца
POST http://localhost:8008/api/v1/seller/ HTTP/1.1
Content-Type: application/json

{
    "first_name": "Test",
    "last_name": "Testov",
    "e_mail": "testsellerr@example.com",
    "password": "pass"
}

###

#Получаем список всех продавцов
GET http://localhost:8008/api/v1/seller/ HTTP/1.1

###

#Получаем продавца по id
GET http://localhost:8008/api/v1/seller/1 HTTP/1.1
Authorization: Bearer {{token}}

###

# Обновляем поля в данных о продавце
PUT http://localhost:8008/api/v1/seller/ HTTP/1.1
Content-Type: application/json

{
    "first_name": "string",
    "last_name": "string",
    "e_mail": "user@example.com"
}

###

#Удаляем продавца
DELETE http://localhost:8008/api/v1/seller/1 HTTP/1.1

###